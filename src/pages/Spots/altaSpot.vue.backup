    var(--color-primary-200) 0%,
    var(--color-primary-500) var(--slider-percent, 50%),
    var(--color-surface-tertiary) var(--slider-percent, 50%)
  );
  outline: none;
  cursor: pointer;
  transition: var(--transition-base);
}

.setting-slider::-webkit-slider-thumb {
