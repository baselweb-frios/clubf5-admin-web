/* Preset Buttons */
.preset-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-2);
}

.btn-sm {
  padding: var(--spacing-2) var(--spacing-3);
  font-size: var(--font-size-sm);
}

/* Enhanced hints with icons */
.setting-hint {
